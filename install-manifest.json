{
  "schemaVersion": 2,
  "product": "Agent Monitor HUD",
  "version": "4.0.2",
  "repository": "https://github.com/LH-03/agent-monitor-hud",
  "releaseTag": "v4.0.2",
  "checksumAsset": "SHA256SUMS.txt",
  "platforms": {
    "windows-x64": {
      "asset": "AgentMonitorHUD-windows-x64.zip",
      "entrypoint": "scripts/install.ps1",
      "installRoot": "~/plugins/codex-monitor-hud",
      "stateRoot": "%LOCALAPPDATA%\\CodexMonitorHUD"
    }
  },
  "rules": {
    "verifyChecksum": true,
    "stopOnChecksumMismatch": true,
    "userLocalInstall": true,
    "preserveSettings": true,
    "retainRollbackFrom3x": true,
    "readSessionContent": false,
    "uploadLocalData": false,
    "handleUserApiKeys": false
  },
  "operations": {
    "install": "scripts/install.ps1",
    "rollback": "scripts/rollback.ps1",
    "uninstall": "scripts/uninstall.ps1"
  },
  "sourceBuild": {
    "toolchain": "rust-toolchain.toml",
    "command": "cargo build --release"
  }
}
